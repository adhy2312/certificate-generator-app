# ── ISTE CertHub — Backend Environment Variables ─────────────────────────────
# Copy this file to backend/.env and fill in your real values.
# NEVER commit the filled-in .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: use SQLite (no setup needed)
DATABASE_URL=sqlite:///./certops.db
# Production (Supabase / Render Postgres): use your full PostgreSQL URL
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Use a Gmail App Password — NOT your regular Gmail password.
# Steps to generate:
#   1. Enable 2-Step Verification at https://myaccount.google.com/security
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Select App: "Mail", Device: "Other (Custom name)" → Generate
# The generated password is 16 characters with spaces (e.g. "abcd efgh ijkl mnop")
SENDER_EMAIL=your_gmail@gmail.com
SENDER_PASS=your_16_char_app_password

# ── Optional: Google Apps Script Proxy ───────────────────────────────────────
# If set, the mailer uses this GAS Web App URL instead of direct SMTP.
# Leave blank to use SMTP directly.
GAS_MAILER_URL=

# ── Admin Gatekeeper Password ─────────────────────────────────────────────────
# Used to protect /api/verify-password, /api/admin/cleanup, and job cancellation.
# Choose a strong password. Must match what's set in Render dashboard.
GATEKEEPER_PASSWORD=your_secure_admin_password_here

